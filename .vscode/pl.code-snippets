{
  // Place your cos3103 workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "Wrap with c`": {
    "prefix": "c`",
    "body": ["```c", "$0", "```"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with js`": {
    "prefix": "js`",
    "body": ["```js", "$0", "```"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with cpp`": {
    "prefix": "cpp`",
    "body": ["```cpp", "$0", "```"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with java`": {
    "prefix": "java`",
    "body": ["```java", "$0", "```"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with python`": {
    "prefix": "python`",
    "body": ["```python", "$0", "```"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with swift`": {
    "prefix": "swift`",
    "body": ["```swift", "$0", "```"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with pascal`": {
    "prefix": "pascal`",
    "body": ["```pascal", "$0", "```"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with text-2xl": {
    "prefix": "t2xl",
    "body": ["[$0]{class=\"text-2xl\"}"],
    "description": "Wraps selected text with defined strings"
  },
  "Wrap with imgw": {
    "prefix": "imgw",
    "body": ["<div class=\"w-[100%] mx-auto\">", "", "$0", "</div>"],
    "description": "Wraps selected text with defined strings"
  },
  "Two-cols-title layout": {
    "prefix": "tcl-",
    "body": [
      "---",
      "layout: two-cols-title",
      "---",
      "",
      "::title::",
      "[$0]{class=\"text-2xl\"}",
      "",
      "::left::",
      "",
      "::right::",
      "",
      "::default::"
    ],
    "description": "Two cols title layout"
  },
    "MD Magic Move": {
    "prefix": "mdmm",
    "body": ["````md magic-move", "", "````"],
    "description": "md magic-move"
  },
  "v-show click=0": {
    "prefix": "vsh0",
    "body": ["<div v-show=\"\\$slidev.nav.clicks == 0\">", "", "</div>"],
    "description": "v-show click=0"
  },
  "v-show click=1": {
    "prefix": "vsh1",
    "body": ["<div v-show=\"\\$slidev.nav.clicks == 1\">", "", "</div>"],
    "description": "v-show click=1"
  },
  "Admonition in neversink theme": {
    "prefix": "admo",
    "body": [
      "<Admonition title=\"Info\" color=\"teal-light\" width=\"300px\" v-drag>",
      "$0",
      "</Admonition>"
    ],
    "description": "Admonition in neversink theme"
  },
  "StickyNote in neversink theme": {
    "prefix": "stck",
    "body": [
      "<StickyNote color=\"amber-light\" textAlign=\"left\" width=\"180px\" title=\"Title\" v-drag>",
      "$0",
      "</StickyNote>"
    ],
    "description": "StickyNote in neversink theme"
  },
  "Box in neversink theme": {
    "prefix": "boxx",
    "body": ["<Box v-drag>", "$0", "</Box>"],
    "description": "Box in neversink theme"
  },
    "Wrap img with class": {
    "prefix": "imgf",
    "body": [
      "<div class=\"w-fit mx-auto\">",
      "",
      "${TM_SELECTED_TEXT/!\\[.*\\]\\(.*?public(\\/.*\\/([^\\/]+)\\.[a-z]+)\\).*/![$2]($1)/}{.max-h-50vh$0}",
      "</div>"
    ],
    "description": "Wrap selected image with class"
  },
  "Wrap with v-click": {
    "prefix": "vclk",
    "body": ["<div v-click>", "", "${TM_SELECTED_TEXT}", "</div>"],
    "description": "Wrap with v-click"
  },
  "Wrap with flex 2 columns": {
    "prefix": "f2cl",
    "body": [
      "<div class=\"flex gap-2\">",
      "<div class=\"w-1/2\">",
      "${TM_SELECTED_TEXT}",
      "</div>",
      "<div class=\"w-1/2\">",
      "",
      "</div>",
      "</div>"
    ],
    "description": "Wrap flex 2 columns",
	"Draw Arrow": {
    "prefix": "arrw",
    "body": [
		"<ArrowDraw color=\"red\" v-drag />"
	],
    "description": "Draw Arrow",
	"Draw Thumb": {
    "prefix": "arrw",
    "body": [
		"<Thumb color=\"green-light\" width=\"300px\" v-drag />"
	],
    "description": "Draw Thumb"

}
